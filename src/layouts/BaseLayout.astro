---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pokémon Z Nuzlocke Tracker",
  description = "Team, graveyard & battle utilities for a Pokémon Z Nuzlocke run.",
} = Astro.props;

const nav = [
  { href: "/", label: "Overview" },
  { href: "/types", label: "Type Chart" },
  { href: "/calc", label: "Damage Calc" },
  { href: "/rules", label: "Rules" },
];

const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? current === "/" : current === href || current.startsWith(href + "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh flex flex-col bg-zinc-950 text-zinc-200 font-sans">
    <header
      class="sticky top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur supports-[backdrop-filter]:bg-zinc-950/60"
    >
      <nav
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
        aria-label="Primary"
      >
        <a
          href="/"
          class="flex items-center gap-2 font-semibold tracking-tight text-zinc-50"
        >
          <span
            class="grid size-7 place-items-center rounded-md border border-white/10 bg-zinc-900 text-emerald-400"
            aria-hidden="true"
          >
            Z
          </span>
          <span>Nuzlocke Tracker</span>
        </a>

        <!-- Desktop links -->
        <ul class="hidden items-center gap-1 sm:flex">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "rounded-md px-3 py-1.5 text-sm transition-colors",
                    isActive(item.href)
                      ? "bg-zinc-800 text-zinc-50"
                      : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-100",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Mobile disclosure menu (no-JS friendly) -->
        <details class="relative sm:hidden">
          <summary
            class="flex size-9 cursor-pointer list-none items-center justify-center rounded-md border border-white/10 bg-zinc-900 text-zinc-200 [&::-webkit-details-marker]:hidden"
            aria-label="Toggle navigation menu"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="4" x2="20" y1="6" y2="6"></line>
              <line x1="4" x2="20" y1="12" y2="12"></line>
              <line x1="4" x2="20" y1="18" y2="18"></line>
            </svg>
          </summary>
          <ul
            class="absolute right-0 mt-2 w-44 overflow-hidden rounded-lg border border-white/10 bg-zinc-900 p-1 shadow-xl shadow-black/40"
          >
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                      "block rounded-md px-3 py-2 text-sm transition-colors",
                      isActive(item.href)
                        ? "bg-zinc-800 text-zinc-50"
                        : "text-zinc-300 hover:bg-zinc-800 hover:text-zinc-50",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 sm:py-10">
      <slot />
    </main>

    <footer class="border-t border-white/10 bg-zinc-950">
      <div
        class="mx-auto max-w-5xl px-4 py-6 text-xs text-zinc-500 sm:px-6"
      >
        Pokémon Z Nuzlocke — personal tracker & companion. Fan project, not
        affiliated with Nintendo, Game Freak, or The Pokémon Company.
      </div>
    </footer>
  </body>
</html>
