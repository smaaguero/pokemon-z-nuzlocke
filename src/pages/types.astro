---
import BaseLayout from "../layouts/BaseLayout.astro";
import TypeCalculator from "../components/battle/TypeCalculator.tsx";
---

<BaseLayout title="Type Chart — Pokémon Z Nuzlocke Tracker">
  <section class="space-y-3">
    <p class="text-sm font-medium text-emerald-400">Battle Utility</p>
    <h1 class="text-2xl font-semibold tracking-tight text-zinc-50 sm:text-3xl">
      Type Effectiveness
    </h1>
    <p class="max-w-2xl text-sm leading-relaxed text-zinc-400">
      Gen&nbsp;6+ matchups. Defensive mode combines a dual typing into a single
      set of weaknesses and resistances; offensive mode shows a move type's
      coverage against every defender.
    </p>
  </section>

  <TypeCalculator client:load />
</BaseLayout>
